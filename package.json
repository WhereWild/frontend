{
  "name": "wherewild",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "node ./scripts/start.mjs",
    "start:production-config": "cross-env EXPO_DOTENV=.env node ./scripts/start.mjs",
    "android": "node ./scripts/start.mjs --android",
    "ios": "node ./scripts/start.mjs --ios",
    "web": "node ./scripts/start.mjs --web",
    "export:web": "node ./scripts/export-web.mjs",
    "sync:router-types": "node ./scripts/sync-router-types.mjs",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "cross-env STRICT_COVERAGE=true jest --ci --coverage --maxWorkers=2",
    "lint": "expo lint",
    "lint:fix": "expo lint --fix",
    "typecheck": "npm run sync:router-types && tsc --noEmit",
    "audit:fabric": "node ./scripts/audit-fabric-risks.mjs",
    "sync-theme": "node ./scripts/sync-theme.cjs",
    "sync-theme:offline": "node ./scripts/sync-theme.cjs --skip-rest-api",
    "sync-theme:rest": "node ./scripts/sync-theme.cjs --rest-api"
  },
  "dependencies": {
    "@expo-google-fonts/domine": "^0.4.2",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@expo/ngrok": "^4.0.0",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "expo": "~54.0.33",
    "expo-constants": "~18.0.10",
    "expo-dev-client": "~6.0.20",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.21",
    "expo-font": "~14.0.9",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-linking": "~8.0.11",
    "expo-router": "~6.0.23",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.10",
    "hyparquet": "^1.25.1",
    "jszip": "^3.10.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.1.0",
    "@types/react-test-renderer": "^19.1.0",
    "cross-env": "^10.1.0",
    "dotenv": "^17.3.1",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.17",
    "jest-junit": "^17.0.0",
    "prettier": "^3.8.1",
    "react-test-renderer": "^19.1.0",
    "typescript": "~5.9.2"
  },
  "private": true,
  "overrides": {
    "@xmldom/xmldom": "^0.8.13",
    "fast-uri": "^3.1.2",
    "postcss": "^8.5.10",
    "glob": {
      "minimatch": {
        "brace-expansion": "^5.0.6"
      }
    }
  }
}
